# TencentDB adapter-only cockpit endpoint profile (v13).
#
# This profile changes neither MemoryCore source/prompts nor benchmark/judge
# prompts. Set run-local TDAI_EVAL_ISOLATION_MAP and
# TDAI_EVAL_CONSTRUCTION_TRACE before construction/retrieval.

export TDAI_HTTP_API_VERSION=v3
export TDAI_EVAL_PERSPECTIVE_MODE=single
export TDAI_EVAL_MEMORY_LAYERS=L0,L1,L2,L3

# Scene-aware transaction gate. Every source turn remains losslessly in L0;
# only durable/pending/profile/update/expiry episodes trigger L1.
export TDAI_EVAL_L1_WRITE_POLICY=cockpit_episode_v2
export TDAI_EVAL_L1_BATCH_MODE=conversation
export TDAI_EVAL_L1_BATCH_MAX_MESSAGES=128
# Coalesce L0-only sessions into bounded assistant-only transport batches.
# Source IDs in the trace reconstruct the original source-session boundaries.
export TDAI_EVAL_L0_BATCH_MODE=session
export TDAI_EVAL_L0_BATCH_MAX_MESSAGES=100
# Independent assistant-only L0 sessions retain their own transport IDs and
# flush concurrently; selected sessions still share one serialized L1 batch.
export TDAI_EVAL_L0_FLUSH_CONCURRENCY=4
export TDAI_EVAL_L1_COMPACT_SELECTED_SESSIONS=true
export TDAI_EVAL_L1_TYPED_EPISODE_HEADERS=true
# Compile source-grounded navigation destination/address/state once at write
# time and reattach it by source ID during retrieval. This sidecar is adapter
# metadata only and does not change MemoryCore extraction prompts.
export TDAI_EVAL_TYPED_COCKPIT_EPISODES=true
# Production/shadow runs should set a run-local absolute SQLite path next to
# the construction trace. It survives process restart and enforces the full
# conversation/team/agent/user/task namespace before any direct answer route.
# Example: export TDAI_EVAL_TYPED_EPISODE_INDEX_PATH=/run/memory/episodes.sqlite3
export TDAI_EVAL_TYPED_EPISODE_INDEX_REQUIRED="${TDAI_EVAL_TYPED_EPISODE_INDEX_REQUIRED:-false}"
export TDAI_EVAL_TYPED_EPISODE_INDEX_TTL_SECONDS="${TDAI_EVAL_TYPED_EPISODE_INDEX_TTL_SECONDS:-0}"
export TDAI_EVAL_TYPED_EPISODE_INDEX_BUSY_TIMEOUT_MS="${TDAI_EVAL_TYPED_EPISODE_INDEX_BUSY_TIMEOUT_MS:-5000}"
# For a trusted relative-time navigation recall, resolve one unique typed
# episode from the local source-bound trace before reading L0 or calling ANN.
# Ambiguous, low-confidence, inactive, or ungrounded rows fail closed.
export TDAI_EVAL_TYPED_EPISODE_SHORT_CIRCUIT=true
# Persist canonical NLU/tool slots only when the top candidate is confident
# and clearly separated from a conflicting N-best hypothesis.
export TDAI_EVAL_TYPED_SLOT_MIN_CONFIDENCE=0.85
export TDAI_EVAL_TYPED_SLOT_MIN_MARGIN=0.08
export TDAI_EVAL_L1_ZERO_OUTPUT_RETRIES=1
export TDAI_EVAL_L1_ZERO_OUTPUT_TERMINAL=l0_only
export TDAI_EVAL_L1_ZERO_OUTPUT_WAIT_FOR_REPAIR=false

# L2/L3 consolidate asynchronously and never block the online L0/L1 path.
export TDAI_EVAL_L23_SCHEDULE=buffered_dirty_event
export TDAI_EVAL_L23_READINESS_MODE=dirty_only
export TDAI_EVAL_ADAPTIVE_LAZY_LAYER_READINESS=true
export TDAI_EVAL_ADAPTIVE_LAYER_WAIT_BUDGET_SECONDS=0

# One broad backend request, exact-slot reranking, then Top-1 or bounded
# Top-3/L1/profile fallback. Candidate breadth does not enlarge answer context.
export TDAI_EVAL_RETRIEVAL_POLICY=adaptive
export TDAI_EVAL_ADAPTIVE_POLICY_VERSION=v2
export TDAI_EVAL_ADAPTIVE_SLOT_RERANK=true
export TDAI_EVAL_CANDIDATE_MULTIPLIER=4
export TDAI_EVAL_ADAPTIVE_FAST_L0_K=1
export TDAI_EVAL_ADAPTIVE_FALLBACK_L0_K=3
export TDAI_EVAL_ADAPTIVE_FALLBACK_L1_K=2
export TDAI_EVAL_ADAPTIVE_FALLBACK_L2_K=1
export TDAI_EVAL_ADAPTIVE_FALLBACK_L3_K=1
export TDAI_EVAL_ADAPTIVE_FAST_CONTEXT_CHARS=900
export TDAI_EVAL_ADAPTIVE_FALLBACK_CONTEXT_CHARS=2200
# Never hand a weak answer model a half-written dialogue line. Finish only
# the current line within this bounded allowance; otherwise backtrack.
export TDAI_EVAL_ADAPTIVE_CONTEXT_LINE_OVERFLOW_CHARS=160

# Restore both the slot answer and the initiating driver turn around an
# assistant clarification.  A two-message look-back covers the common
# driver -> assistant clarification -> driver slot-value pattern while the
# eight-message cap still bounds long source sessions.
export TDAI_EVAL_L0_WINDOW_BEFORE=2
export TDAI_EVAL_L0_WINDOW_AFTER=12
export TDAI_EVAL_L0_WINDOW_MAX_MESSAGES=8
export TDAI_EVAL_L0_EXPLICIT_DATE_RESULTS=2
export TDAI_EVAL_L0_EXPLICIT_DATE_BOOST=true
export TDAI_EVAL_INGEST_RESOLVE_RELATIVE_TIME=true
export TDAI_EVAL_L0_RESOLVE_RELATIVE_TIME=true

# Resolve relative query expressions against trusted query_time/question_date
# metadata, then add source-time and semantic-event-time L0 candidates before
# ANN top-k. The deterministic parser adds no model call.
export TDAI_EVAL_TEMPORAL_QUERY_MODE=interval_v1
export TDAI_EVAL_TEMPORAL_QUERY_RESULTS=3
export TDAI_EVAL_TEMPORAL_EVENT_TIME_MATCH=true
export TDAI_EVAL_TEMPORAL_DEFAULT_TIMEZONE=UTC
export TDAI_EVAL_TEMPORAL_SHORT_CIRCUIT=true

# Keep the benchmark/system prompt byte-identical. Only time-sensitive user
# questions receive a compact, deterministic request-time envelope.
export MEMEVAL_ANSWER_TEMPORAL_QUERY_MODE=interval_v1
export MEMEVAL_ANSWER_TEMPORAL_DEFAULT_TIMEZONE=UTC
# Losslessly answer an unambiguous command -> clarification -> reply chain
# without an LLM call; every other question falls back to the answer model.
export MEMEVAL_ANSWER_DETERMINISTIC_SLOT_MODE=cockpit_v1

# Prefer TokenPlan construction. Callers may override the model without
# editing or committing provider credentials.
export MEMORY_LLM_MODEL="${TDAI_EVAL_CONSTRUCTION_MODEL:-qwen3.6-flash}"
export MEMORY_PIPELINE_L1_IDLE_SECONDS=5
export MEMORY_MAX_MESSAGES_PER_EXTRACTION=40
export MEMORY_PIPELINE_L2_DELAY_SECONDS=180
export MEMORY_PIPELINE_L2_MIN_INTERVAL_SECONDS=900
export MEMORY_PIPELINE_L2_MAX_INTERVAL_SECONDS=7200
# L2/L3 currently share an agent-scoped lock; serialize within one endpoint.
# Evaluation-level sharding can still construct independent scopes in parallel.
export MEMORY_PIPELINE_WORKER_CONCURRENCY=1

export TDAI_EVAL_READY_SETTLE_SECONDS=210
export TDAI_EVAL_L1_READY_SETTLE_SECONDS=10
export TDAI_EVAL_CLEAN_READY_SETTLE_SECONDS=10
