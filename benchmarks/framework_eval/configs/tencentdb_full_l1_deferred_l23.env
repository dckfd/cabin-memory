# Non-secret MemoryCore profile for the full L0/L1 construction baseline.
# Run this store in its own volume, retrieve the L0/L1 arms, then stop the
# container.  The long L2 delay prevents unused profile work from consuming
# model tokens while preserving MemoryCore's native pipeline implementation.

export MEMORY_PROMPT_MODE=cockpit
export MEMORY_PIPELINE_L1_IDLE_SECONDS=5
export MEMORY_PIPELINE_L2_DELAY_SECONDS=86400
export MEMORY_PIPELINE_L2_MIN_INTERVAL_SECONDS=86400
export MEMORY_PIPELINE_L2_MAX_INTERVAL_SECONDS=172800
export MEMORY_PIPELINE_WORKER_CONCURRENCY=4
