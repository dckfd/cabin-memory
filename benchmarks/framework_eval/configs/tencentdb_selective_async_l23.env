# Non-secret profile for the selective-l1-async-l23 endpoint.
# Source this before starting MemoryCore and the framework-eval retrieval run.
# TDAI_EVAL_CONSTRUCTION_TRACE must be set separately to a run-local JSONL
# file (ingestion) or a directory of completed shard JSONL files (retrieval).

export TDAI_HTTP_API_VERSION=v3
export TDAI_EVAL_PERSPECTIVE_MODE=single
export TDAI_EVAL_MEMORY_LAYERS=L0,L1,L2,L3
export TDAI_EVAL_L1_WRITE_POLICY=cockpit_selective_v1
export TDAI_EVAL_L1_BATCH_MODE=conversation
export TDAI_EVAL_L1_BATCH_MAX_MESSAGES=128
export TDAI_EVAL_L1_COMPACT_SELECTED_SESSIONS=true
# A selected fresh scope must not silently finish with zero L1 output. The
# adapter audits it before retrieval and replays only the selected compact
# batch once. Persistent semantic emptiness is explicitly recorded as L0-only;
# transport/provider failures remain retryable inside MemoryCore itself.
export TDAI_EVAL_L1_ZERO_OUTPUT_RETRIES=1
export TDAI_EVAL_L1_ZERO_OUTPUT_TERMINAL=l0_only
# The online path never waits for the compensation result. L1 and any derived
# L2/L3 profile continue in the worker while the request answers from lossless
# L0; a later request observes the resulting L1 count.
export TDAI_EVAL_L1_ZERO_OUTPUT_WAIT_FOR_REPAIR=false
export TDAI_EVAL_L23_SCHEDULE=buffered_dirty_event
export TDAI_EVAL_L23_READINESS_MODE=dirty_only

# Memory construction is structured extraction rather than final-answer
# generation. Use TokenPlan's low-latency tool-capable model by default while
# allowing another deployment to override it without editing this profile.
export MEMORY_LLM_MODEL="${TDAI_EVAL_CONSTRUCTION_MODEL:-qwen3.6-flash}"

# Deterministic L0-first routing. L2/L3 are read only on the fallback path.
export TDAI_EVAL_RETRIEVAL_POLICY=adaptive
export TDAI_EVAL_ADAPTIVE_LAZY_LAYER_READINESS=true
# Online cockpit requests never wait for asynchronous profiles. If L2/L3 are
# already available they are injected; otherwise L0/L1 answer immediately.
export TDAI_EVAL_ADAPTIVE_LAYER_WAIT_BUDGET_SECONDS=0
export TDAI_EVAL_ADAPTIVE_FAST_L0_K=1
export TDAI_EVAL_ADAPTIVE_FALLBACK_L0_K=3
export TDAI_EVAL_ADAPTIVE_FALLBACK_L1_K=2
export TDAI_EVAL_ADAPTIVE_FALLBACK_L2_K=1
export TDAI_EVAL_ADAPTIVE_FALLBACK_L3_K=1
export TDAI_EVAL_ADAPTIVE_FAST_CONTEXT_CHARS=900
export TDAI_EVAL_ADAPTIVE_FALLBACK_CONTEXT_CHARS=2600
export TDAI_EVAL_L0_WINDOW_BEFORE=1
export TDAI_EVAL_L0_WINDOW_AFTER=12

# Keep L1 fresh, but batch profile construction behind a fifteen-minute window.
# MemoryCore's native timer uses set-if-earlier semantics, so later dirty L1
# events join the pending batch instead of postponing it indefinitely.
export MEMORY_PIPELINE_L1_IDLE_SECONDS=5
# Compact each selected short source session into one lossless, provenance-
# preserving row. Forty fragmented commands fit both current cockpit datasets
# in one extraction and avoid repeated prompt/conflict-detection overhead.
export MEMORY_MAX_MESSAGES_PER_EXTRACTION=40
# TokenPlan Flash completed the measured 19-row build in under one minute.
# Leave three minutes for a residual second batch before profile construction.
export MEMORY_PIPELINE_L2_DELAY_SECONDS=180
export MEMORY_PIPELINE_L2_MIN_INTERVAL_SECONDS=900
export MEMORY_PIPELINE_L2_MAX_INTERVAL_SECONDS=7200
# L2/L3 take an agent-scoped distributed lock.  A benchmark conversation can
# enqueue several session tasks for the same agent at once; multiple workers
# then spend their time retrying the same lock and can eventually drop work.
# Serialize this profile until MemoryCore exposes keyed (per-agent) workers.
export MEMORY_PIPELINE_WORKER_CONCURRENCY=1

# Dirty scopes wait past the hidden L2 timer. Proven-clean scopes only perform
# a short queue-settle check and never poll nonexistent L2/L3 documents.
export TDAI_EVAL_READY_SETTLE_SECONDS=210
export TDAI_EVAL_L1_READY_SETTLE_SECONDS=10
export TDAI_EVAL_CLEAN_READY_SETTLE_SECONDS=10
