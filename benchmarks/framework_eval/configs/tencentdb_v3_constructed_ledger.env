# TencentDB v7: construction-enriched, compact long-dialogue retrieval.
#
# Set TDAI_EVAL_ISOLATION_MAP and TDAI_EVAL_LEDGER_PATH to artifacts from the
# same run before invoking framework_eval.cli.  The ledger is built without
# benchmark questions/answers and adds no model call at retrieval time.

export TDAI_HTTP_API_VERSION=v3
export TDAI_EVAL_PERSPECTIVE_MODE=auto
export TDAI_EVAL_MEMORY_LAYERS=L0,L1,L2,L3

# Normalize only unambiguous relative dates before MemoryCore performs L1/L2/L3
# construction.  Retrieval keeps the same idempotent rendering behavior.
export TDAI_EVAL_INGEST_RESOLVE_RELATIVE_TIME=true
export TDAI_EVAL_L0_RESOLVE_RELATIVE_TIME=true
export TDAI_EVAL_L0_HUMANIZE_TIME=true

# Reserve one compact row for source-grounded exact facts.  Fact count controls
# the contents of that one row and therefore does not consume ten Top-K slots.
export TDAI_EVAL_LEDGER_FACT_RESULTS=10
export TDAI_EVAL_LEDGER_MAX_CHARS=3500
export TDAI_EVAL_LEDGER_INCLUDE_ROLLUPS=true

# Compact target: with Top-K 16, one ledger + one L2 + one L3 leave thirteen
# dynamic L0/L1 slots, of which at least eight are raw dialogue anchors.
export TDAI_EVAL_L2_RESULTS=1
export TDAI_EVAL_L3_RESULTS=1
export TDAI_EVAL_L2_MAX_CHARS=2200
export TDAI_EVAL_L3_MAX_CHARS=1800
export TDAI_EVAL_CANDIDATE_MULTIPLIER=5
export TDAI_EVAL_L0_MIN_RESULTS=0
export TDAI_EVAL_L0_MIN_FRACTION=0.60
export TDAI_EVAL_L0_WINDOW_RADIUS=1
export TDAI_EVAL_L0_SESSION_BM25_RESULTS=0
export TDAI_EVAL_L0_DIVERSE_RESULTS=0
export TDAI_EVAL_L0_FIRST=false
export TDAI_EVAL_L0_LAST=false
export TDAI_EVAL_L0_MARK_ANCHORS=false

# Query-adaptive raw evidence is retained, but capped below the v6 profile.
export TDAI_EVAL_L0_FOCUS_ANCHORS=6
export TDAI_EVAL_L0_REASONING_FOCUS_ANCHORS=8
export TDAI_EVAL_L0_FOCUS_MODE=aggregate,when,emotion,inference
export TDAI_EVAL_L0_FOCUS_BEFORE=0
export TDAI_EVAL_L0_FOCUS_AFTER=0
export TDAI_EVAL_L0_FOCUS_RESPONSE_RADIUS=4
export TDAI_EVAL_L0_FOCUS_MAX_CHARS=2200
