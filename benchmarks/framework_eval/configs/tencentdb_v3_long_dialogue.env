# Generic TencentDB v3 long-dialogue retrieval profile.
# Source this file before `framework_eval.cli retrieval`; provide the run's
# isolation manifest and API key separately. No benchmark labels are used.

export TDAI_HTTP_API_VERSION=v3
export TDAI_EVAL_PERSPECTIVE_MODE=auto
export TDAI_EVAL_MEMORY_LAYERS=L0,L1,L2,L3

# Keep compact high-level memories while reserving 75% of dynamic slots for
# raw dialogue. The fractional quota scales with a benchmark's chosen Top-K.
export TDAI_EVAL_L2_RESULTS=1
export TDAI_EVAL_L3_RESULTS=1
export TDAI_EVAL_L2_MAX_CHARS=3000
export TDAI_EVAL_L3_MAX_CHARS=2500
export TDAI_EVAL_CANDIDATE_MULTIPLIER=5
export TDAI_EVAL_L0_MIN_RESULTS=0
export TDAI_EVAL_L0_MIN_FRACTION=0.75

# Recover the answer beside a semantic anchor within the same source Session.
export TDAI_EVAL_L0_WINDOW_RADIUS=2
export TDAI_EVAL_L0_SESSION_BM25_RESULTS=0
export TDAI_EVAL_L0_DIVERSE_RESULTS=0
export TDAI_EVAL_L0_FIRST=false
export TDAI_EVAL_L0_LAST=false
export TDAI_EVAL_L0_MARK_ANCHORS=false

# Deterministic time normalization and query-adaptive raw-dialogue focus.
export TDAI_EVAL_L0_RESOLVE_RELATIVE_TIME=true
export TDAI_EVAL_L0_HUMANIZE_TIME=true
export TDAI_EVAL_L0_FOCUS_ANCHORS=6
export TDAI_EVAL_L0_REASONING_FOCUS_ANCHORS=10
export TDAI_EVAL_L0_FOCUS_MODE=aggregate,when,emotion,inference
export TDAI_EVAL_L0_FOCUS_BEFORE=0
export TDAI_EVAL_L0_FOCUS_AFTER=0
export TDAI_EVAL_L0_FOCUS_RESPONSE_RADIUS=4
export TDAI_EVAL_L0_FOCUS_MAX_CHARS=3000
