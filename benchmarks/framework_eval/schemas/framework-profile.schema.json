{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.tencentdb-memory/schemas/framework-profile.schema.json",
  "title": "Memory framework plugin catalog",
  "type": "object",
  "required": ["version", "profiles"],
  "properties": {
    "version": {"const": 1},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "execution", "status", "capabilities", "runtime", "prerequisites", "services", "official_entrypoints", "supported_datasets"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "execution": {"enum": ["in_process", "http", "external_process", "native_runner", "unavailable"]},
          "status": {"type": "string"},
          "bridge": {"type": "string"},
          "command": {"type": "array", "items": {"type": "string"}},
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["ingest", "search", "answer", "reflect", "wait_until_ready", "update", "delete", "profile", "graph", "drill_down"]}
          },
          "runtime": {"type": "string"},
          "python": {"type": "string"},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "services": {"type": "array", "items": {"type": "string"}},
          "official_entrypoints": {"type": "array", "items": {"type": "string"}},
          "supported_datasets": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
