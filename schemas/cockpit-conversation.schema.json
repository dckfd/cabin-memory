{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dckfd/cabin-memory/schemas/cockpit-conversation.schema.json",
  "title": "Cockpit memory conversation JSONL row",
  "type": "object",
  "required": ["sample_id", "sessions"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["messages"],
        "anyOf": [
          {"required": ["source_session_id"]},
          {"required": ["session_id"]}
        ],
        "properties": {
          "source_session_id": {"type": "string", "minLength": 1},
          "session_id": {"type": "string", "minLength": 1},
          "date_time": {"type": "string", "format": "date-time"},
          "timestamp": {"type": "string", "format": "date-time"},
          "metadata": {"type": "object"},
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "message_id": {"type": "string", "minLength": 1},
                "role": {"enum": ["user", "assistant", "system", "tool"]},
                "speaker": {"type": "string"},
                "content": {"type": "string", "minLength": 1},
                "timestamp": {"type": "string", "format": "date-time"},
                "metadata": {"type": "object"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
